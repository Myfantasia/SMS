# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --------------------------------------------------------
# DJANGO CORE
# --------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Your Postgres password (required — there is no fallback default for this one).
DB_PASSWORD=
# Optional — only set these if they differ from school_db/postgres/localhost/5432:
# DB_NAME=
# DB_USER=
# DB_HOST=
# DB_PORT=
# Defaults to True/localhost for local dev. Before deploying anywhere real, set:
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DEBUG=
# ALLOWED_HOSTS=

# --------------------------------------------------------
# REDIS (cache backend, Channels layer, Celery broker) — requires a Redis server
# running locally: sudo apt install redis-server && sudo systemctl enable --now redis-server
# --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --------------------------------------------------------
# CELERY (background jobs — timetable generation, bulk allocation, bulk results)
# --------------------------------------------------------
# Defaults to REDIS_URL's host/port on DB index 1 (separate from the cache's index 0).
# Only set this if you want the broker on a different Redis instance/index entirely.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
#
# A worker process needs to be running alongside `manage.py runserver` at all times, or
# every bulk-operation endpoint returns 503 (school/jobs.py:is_worker_available checks
# this before creating a job — no worker means nothing would ever pick it up otherwise).
# The 4 heavy bulk-operation tasks are routed onto the "bulk_ops" queue (see
# CELERY_TASK_ROUTES in settings.py) and MUST be run with --concurrency=1 — they mutate
# overlapping allocation/timetable data, so two running at once is a correctness risk,
# not just a load one.
#
# DON'T just run the command below directly in a terminal for anything but a quick,
# throwaway check — a worker started that way dies the moment that terminal/session
# ends. Use the systemd user service instead (already installed at
# ~/.config/systemd/user/celery-bulk-ops.service), which survives closed terminals and
# auto-restarts within seconds if the process ever crashes:
#   systemctl --user status celery-bulk-ops     # check it's running
#   systemctl --user restart celery-bulk-ops    # restart after editing orchestration/tasks.py
#   journalctl --user -u celery-bulk-ops -f     # tail its logs
# (`loginctl enable-linger $USER` — already run once — makes it survive full logout too,
# not just closed terminals.)
#
# The raw command, for reference / if you ever need to run one manually:
#   celery -A schoolmanagement worker -Q bulk_ops --concurrency=1 -l info
# If you add other, unrelated background tasks later, run a second worker for the
# default queue at whatever concurrency fits (this one is safe to parallelize):
#   celery -A schoolmanagement worker -Q celery -l info
# Without a bulk_ops worker running, timetable/rollover/bulk-allocate/bulk-results jobs
# will sit in PENDING and never complete — they are NOT processed inline by the web process.

# --------------------------------------------------------
# EMAIL (password reset links, "your password changed" notices, admin/teacher-reset
# notices). Leave EMAIL_HOST_USER/EMAIL_HOST_PASSWORD blank to keep emails printing to
# the console instead of actually sending — fine for local dev, useless in production.
# --------------------------------------------------------
# Your Gmail address:
EMAIL_HOST_USER=
# A Gmail App Password (NOT your normal Google password) — generate one at
# myaccount.google.com/apppasswords. Requires 2-Step Verification to be enabled first.
EMAIL_HOST_PASSWORD=
# Optional — defaults to EMAIL_HOST_USER if unset.
DEFAULT_FROM_EMAIL=
# Optional — override only if you're using a non-Gmail SMTP provider.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# --------------------------------------------------------
# MAINTENANCE MODE
# --------------------------------------------------------
# When true, only authenticated admins can access anything beyond the public marketing
# pages and the admin login/signup flow. Toggling this requires a server restart.
MAINTENANCE_MODE=False
