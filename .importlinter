[importlinter:contract:no-model-import-allocations]
name = allocations may not import another app's models
type = forbidden
# Direct imports only -- calling another app's services.py (which itself
# imports that app's own models internally) must stay legal; only a direct
# `from apps.X.models import ...` elsewhere is the actual violation.
allow_indirect_imports = True
# Flagged tech debt, not an oversight: apps/allocations/services.py's
# rollover_allocations/bulk_auto_allocate need a real ClassStream model
# instance (not just a DTO) to pass into AllocationValidator's grade/teacher
# traversal (alloc.classroom.grade, etc.) -- apps.academics.services only
# returns DTOs by design, so a full rewrite of the validator to work off DTOs
# is a real refactor of working allocation logic, not a mechanical import
# fix. Deferred here the same way Track B step 6/7 deferred the orchestration
# extraction and the analytics dashboard rewrite -- track as its own future
# pass, not smuggled into a model-relocation step.
# bulk_auto_allocate also needs a real TeacherExtra instance for the same
# reason (qualification/availability checks in school/utils.py's helpers
# operate on model instances) -- newly visible once identity's models moved
# out of school/models/ in Track B step 9.
ignore_imports =
    apps.allocations.services -> apps.academics.models
    apps.allocations.services -> apps.identity.models
source_modules =
    apps.allocations
forbidden_modules =
    apps.identity.models
    apps.academics.models
    apps.students.models
    apps.staff.models
    apps.attendance.models
    apps.assignments.models
    apps.messaging.models
    apps.finance.models
    apps.timetable.models
    apps.exams.models
    apps.results.models
    apps.analytics.models
    apps.content.models

