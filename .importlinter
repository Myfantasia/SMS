[importlinter:contract:no-model-import-analytics]
name = analytics may not import another app's models
type = forbidden
# Direct imports only -- calling another app's services.py (which itself
# imports that app's own models internally) must stay legal; only a direct
# `from apps.X.models import ...` elsewhere is the actual violation.
allow_indirect_imports = True
# Flagged tech debt, not an oversight: apps/analytics/views.py's 4 view classes
# do deep multi-model aggregate/annotate/values queries directly against
# ExamResult/SubjectTermResult/StudentTermResult/ClassPerformanceAnalytics
# (school-wide grade distributions, term-over-term improvement, subject
# matrices) -- this predates the modular monolith split (Track B step 1 already
# noted "neither view file was rewired to go through services internally...
# kept out of scope to keep that step's blast radius small") and was invisible
# to import-linter until these models physically moved out of school/models/ in
# Track B step 7. Wrapping every query here in DTO-returning services.py
# functions is a real rewrite of this dashboard's data layer, not a mechanical
# fix -- it's the same "analytics is the first true extraction candidate" work
# the plan's event-bus section already names as a distinct future project, so
# it's tracked there rather than forced into a model-relocation step.
# apps.identity.models added in Track B step 9, same reasoning: StudentExtra
# queries here predate the split and became detectable only once identity's
# models physically moved out of school/models/.
ignore_imports =
    apps.analytics.views -> apps.exams.models
    apps.analytics.views -> apps.results.models
    apps.analytics.views -> apps.academics.models
    apps.analytics.views -> apps.identity.models
source_modules =
    apps.analytics
forbidden_modules =
    apps.identity.models
    apps.academics.models
    apps.students.models
    apps.staff.models
    apps.allocations.models
    apps.attendance.models
    apps.assignments.models
    apps.messaging.models
    apps.finance.models
    apps.timetable.models
    apps.exams.models
    apps.results.models
    apps.content.models

