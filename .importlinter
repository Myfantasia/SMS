# --- Contract 3: messaging is reached only via the event bus ---
# Verbatim enforcement of the original spec's example: "exams never imports
# messaging directly." No other app -- not even via services.py -- may
# import apps.messaging at all; the only path in is shared/events.
[importlinter:contract:messaging-via-bus-only]
name = Messaging is reached via the event bus only, never a direct import
type = forbidden
source_modules =
    apps.identity
    apps.academics
    apps.students
    apps.staff
    apps.allocations
    apps.timetable
    apps.exams
    apps.results
    apps.attendance
    apps.assignments
    apps.finance
    apps.analytics
    apps.core
    apps.content
forbidden_modules =
    apps.messaging
