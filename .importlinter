[importlinter]
root_packages =
    apps
    orchestration

# --- Contract 1: dependency direction ---
# Each layer may import any layer strictly below it. Same-layer siblings
# (grouped with `|`) may not import each other. `orchestration` sits above
# everything -- it's the one documented exception to "apps never import
# each other" (see the allocations<->timetable problem in the modular
# monolith plan), and nothing is allowed to import it back.
[importlinter:contract:app-layering]
name = Modular monolith dependency direction
type = layers
# identity.admin registers a StudentSubjectEnrollmentInline on StudentExtraAdmin
# (Django admin inlines require a real model class, not a DTO) -- an upward
# read from the foundation layer, same class of "presentation layer needs a
# real model instance" exception already granted to services.py call sites
# elsewhere in this file. Tracked, not a design change: the inline belongs
# conceptually to students, but Django's admin API ties it to the parent
# model's ModelAdmin, which lives with StudentExtra in identity.
ignore_imports =
    apps.identity.admin -> apps.students.models
layers =
    orchestration
    apps.analytics
    apps.results
    apps.exams
    apps.timetable
    apps.allocations | apps.staff | apps.attendance | apps.assignments | apps.messaging | apps.finance
    apps.students
    apps.academics
    apps.identity
    apps.core | apps.content

# --- Contract 2: no cross-app model imports (one contract per app) ---
# Every app's public surface is its services.py -- models.py is private to
# the app that owns it. Split into one `forbidden` contract per app rather
# than one contract listing all 12 apps as both source and target, because
# import-linter's `forbidden` contract can't check a package against its own
# submodule ("shared descendants" error) -- so each app's own models.py is
# simply left off its own forbidden list instead of needing an
# ignore_imports exception.

[importlinter:contract:no-model-import-identity]
name = identity may not import another app's models
type = forbidden
# Direct imports only -- calling another app's services.py (which itself
# imports that app's own models internally) must stay legal; only a direct
# `from apps.X.models import ...` elsewhere is the actual violation.
allow_indirect_imports = True
# Same Django-admin-inline exception as the app-layering contract above --
# StudentSubjectEnrollmentInline needs the real StudentSubjectEnrollment
# model class to register on StudentExtraAdmin.
ignore_imports =
    apps.identity.admin -> apps.students.models
source_modules =
    apps.identity
forbidden_modules =
    apps.academics.models
    apps.students.models
    apps.staff.models
    apps.allocations.models
    apps.attendance.models
    apps.assignments.models
    apps.messaging.models
    apps.finance.models
    apps.timetable.models
    apps.exams.models
    apps.results.models
    apps.analytics.models
    apps.content.models

